{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gama",
  "version": "0.1.0",
  "identifier": "com.gabrielgriffo.gama",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/gama/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Gama",
        "width": 1100,
        "height": 600,
        "minWidth": 1100,
        "minHeight": 600,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "publisher": "Gabriel Griffo",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNzk5QzMyNUZDQzFDNDUKUldSRkhNeGZNcHg1OFJBVytYVkQ3NjBwYStRNitaV3RPZlJqYWxpSnBuZDBmQXpIMHBpQW1BSDgK",
      "endpoints": [
        "https://github.com/gabrielgriffo/gama-jira-assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
