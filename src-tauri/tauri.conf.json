{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gama",
  "version": "0.1.0",
  "identifier": "com.gabrielgriffo.gama",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/gama/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Gama: Assistente desktop",
        "width": 1100,
        "height": 600,
        "minWidth": 1100,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://*.atlassian.net https://*.atlassian.com https://*.atl-paas.net",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "publisher": "Gabriel Griffo",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
